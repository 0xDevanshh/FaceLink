# ---------------------------------------------------------------------------
# FaceChain configuration — copy to .env and fill in.
# TESTNET ONLY. Never put a mainnet private key in this file.
# ---------------------------------------------------------------------------

# --- blockchain: Ethereum Sepolia (chain id 11155111) ---
BASE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Private key of the attester wallet, 0x-prefixed. Generate a throwaway one:
#   python -c "from eth_account import Account; a=Account.create(); print(a.address, a.key.hex())"
# Then fund it from a free faucet (see README).
PRIVATE_KEY=

# Optional cache. The schema UID is derived deterministically from the schema
# string, so leaving this blank is fine — the pipeline computes it.
EAS_SCHEMA_UID=
# Optional: address the attestation is "about". Defaults to the zero address.
ATTESTATION_RECIPIENT=0x0000000000000000000000000000000000000000

# --- reverse image search ---
# Engines to fan out across. Browser engines (no key needed): yandex, bing,
# google_lens, tineye. API engines (need SERPAPI_KEY below):
# serpapi_google_lens (never needs a public URL — uses SerpAPI's own
# direct-upload endpoint), serpapi_yandex and serpapi_bing (both genuinely
# require a public URL — SerpAPI has no upload alternative for these two).
ENGINES=yandex,bing,google_lens
HEADLESS=true
SEARCH_TIMEOUT_S=60
# Optional: a real reverse-image-search API used when browser adapters get
# CAPTCHA'd. Free tier ~100 searches/month. Leave blank to skip.
SERPAPI_KEY=

# --- Tier-1 face-search APIs (optional — leave blank to skip) ---
# FaceCheck.ID API key (paid — https://facecheck.id)
FACECHECK_API_KEY=
# Search4Faces API key
SEARCH4FACES_API_KEY=

# --- verification thresholds ---
FACE_MATCH_THRESHOLD=0.38
IMAGE_MATCH_THRESHOLD=0.80
VERIFY_MIN_SCORE=0.70
# Ranking-only cutoff: a verified candidate at or above this face similarity
# is promoted ahead of every candidate below it. Independent of
# FACE_MATCH_THRESHOLD (decides whether a candidate can verify at all) and
# the final_score weights (still decide ties) — this only reorders results.
# It does NOT accept or reject anything — see FACE_ONLY_VERIFY_* below for that.
HIGH_FACE_SIMILARITY_PRIORITY=0.75
# Off by default. A candidate normally needs the *combined* score
# (0.5*face + 0.4*image + 0.1*metadata) >= VERIFY_MIN_SCORE to verify — a
# strong face match on a very different-looking retrieved image (heavy crop,
# filter, low-quality repost) can still fail that combined bar. Enabling this
# adds a second, independent path: face similarity alone, at or above
# FACE_ONLY_VERIFY_THRESHOLD, is sufficient on its own. Real tradeoff: this
# raises the false-accept rate, since image/metadata support is no longer
# required for a candidate accepted this way. A deliberate policy choice, not
# a bug fix — leave off unless you specifically want this behavior.
FACE_ONLY_VERIFY_ENABLED=false
FACE_ONLY_VERIFY_THRESHOLD=0.50
MAX_CANDIDATES_TO_VERIFY=12
# Optional: path to a CalibrationResult JSON written by
# `python -m facechain.benchmark --out calibration.json ...`. When set and its
# status is CALIBRATED, every case's threshold_snapshot records that instead
# of the honest default "not calibrated" state. Does not change any threshold.
CALIBRATION_FILE=

# --- face quality gating ---
MIN_FACE_PX=80
QUALITY_BLUR_THRESHOLD=40.0
QUALITY_MIN_BRIGHTNESS=15.0
QUALITY_MAX_BRIGHTNESS=240.0
MAX_IMAGE_EDGE=8000
# multi_face_policy: reject | largest | all
MULTI_FACE_POLICY=largest

# --- face backend: auto | insightface | opencv ---
FACE_BACKEND=auto
INSIGHTFACE_MODEL=buffalo_l

# --- web server (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated allowed CORS origins. Never use wildcard (*) in production.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_UPLOAD_MAX_MB=10
API_MAX_CONCURRENT_SCANS=4
API_JOB_TTL_S=3600

# --- optional: temporary public image hosting ---
# When a public URL for the uploaded image is available, every search engine
# can use its much more reliable by-URL endpoint instead of an in-page upload
# flow, which significantly reduces CAPTCHA/bot-detection failures.
#
# Two methods (tried in priority order):
#
# Method 1 — Local server (recommended, no third-party upload):
#   Set LOCAL_IMAGE_BASE_URL to the public base URL of this server, e.g.
#   https://myhost.example.com:8000  (must be reachable by search engines)
#   The server exposes /api/v1/tmp-image/{token} and auto-expires tokens.
LOCAL_IMAGE_BASE_URL=

# Method 2 — Third-party host (fallback, off by default):
#   Uploads to Litterbox (1h TTL). Only used when LOCAL_IMAGE_BASE_URL is not set.
#   This sends the photo to an external service — opt-in required.
ALLOW_UPLOAD_HOST=false
UPLOAD_HOST=https://litterbox.catbox.moe/resources/internals/api.php

# --- Luxand.cloud face recognition (optional) ---
# When set, every scan also calls Luxand's /photo/search/v2 endpoint as an
# independent second-opinion face recognition check.  Results are additive —
# they never lower the ArcFace score.  Free trial available at luxand.cloud.
LUXAND_API_KEY=
