# secrets — never commit
.env
.wallet-backup.txt
*.pem
*.key

# evidence bundles contain a copy of the input photo and matched image hashes.
# Keep the directory, ignore real cases (commit one redacted sample if you like).
evidence/*
!evidence/.gitkeep
!evidence/sample_case/

# model cache (hundreds of MB, downloaded on first run)
.models/
.insightface/

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/

# uploads (server temp dir)
/tmp/facechain_uploads/

# os / editor
.DS_Store
.idea/
.vscode/
